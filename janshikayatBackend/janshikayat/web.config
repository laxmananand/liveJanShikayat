<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\janshikayat.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <!-- Read only when hosted on IIS; a local run (dotnet run / Visual Studio) keeps using launchSettings and user-secrets -->
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="Otp__Sms__Gateway__SecureKey" value="3ec694c4-3596-427f-87d8-08b26192b917" />
          <environmentVariable name="Otp__Sms__Gateway__Username" value="BIHAREDISTRICT-nori" />
          <environmentVariable name="Otp__Sms__Gateway__Password" value="Sadiya123@@" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
